{
  "name": "andrey-digital-card",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "NestJS / Prisma / GraphQL developer profile backend",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:smoke": "node scripts/smoke.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node dist/scripts/seed.js"
  },
  "dependencies": {
    "@apollo/server": "^4.11.0",
    "@nestjs/apollo": "^12.2.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/graphql": "^12.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@prisma/client": "6.19.0",
    "dataloader": "^2.2.3",
    "dotenv": "^16.4.5",
    "graphql": "^16.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "jest": "^29.7.0",
    "prisma": "6.19.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "engines": {"node": ">=20"},
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": ".",
    "testRegex": "\\.spec\\.ts$",
    "transform": {"^.+\\.(t|j)s$": ["ts-jest", {"tsconfig": "tsconfig.json"}]},
    "testEnvironment": "node"
  }
}
